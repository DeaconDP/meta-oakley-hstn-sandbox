   "y0": 144.23333333333335,
   "x1": 101.0,
   "y1": 147.73333333333335,
   "col": 0,
   "heading": false,
   "para_end": false,
   "soft_hyphen": false,
   "hard_break_hyphen": false
  },
  {
   "text": "Let the most absent-minded of men be plunged in his",
   "x0": 12.0,
   "y0": 148.60777777777778,
   "x1": 101.0,
   "y1": 152.10777777777778,
   "col": 0,
   "heading": false,
   "para_end": false,
   "soft_hyphen": false,
   "hard_break_hyphen": false
  },
  {
   "text": "deepest reveries—stand that man on his legs, set his",
   "x0": 12.0,
   "y0": 152.98222222222222,
   "x1": 101.0,
   "y1": 156.48222222222222,
   "col": 0,
   "heading": false,
