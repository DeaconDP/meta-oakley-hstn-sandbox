<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SpeakUp (App Store) app. The App Group is shared with the SpeakUp Share extension, which leaves
  shared photos and PDFs there for the app to read (A11y/Import, notes/reach-ios.md). The group
  must be registered for the team before a device build.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.deaco.speakup</string>
	</array>
</dict>
</plist>
