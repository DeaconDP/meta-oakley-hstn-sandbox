// Secrets.xcconfig - local build secrets. Copy this file to Secrets.xcconfig (same folder) and
// fill it in. Secrets.xcconfig is gitignored; never commit a real key.
//
// The key ends up inside the app bundle's Info.plist, so only use this for your own development
// builds. For anything you hand to someone else, leave it empty and paste a key in the app's
// Settings instead (stored in the Keychain).

OPENAI_API_KEY = sk-your-key-here
